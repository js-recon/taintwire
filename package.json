{
    "name": "@js-recon/taintwire",
    "version": "0.1.1",
    "description": "Graph-based (LadybugDB/openCypher) AST and taint analysis for JavaScript",
    "type": "module",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build"
    ],
    "scripts": {
        "build": "rm -rf build/ && tsc",
        "test": "vitest run --testTimeout=30000",
        "graph:stats": "node scripts/graph-stats.mjs"
    },
    "author": "Shriyans Sudhi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/js-recon/taintwire.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@babel/parser": "8.0.4",
        "@babel/types": "8.0.4",
        "@ladybugdb/core": "0.21.2",
        "@shriyanss/cs-mast": "0.1.8",
        "@babel/types-7": "npm:@babel/types@^7.29.8"
    },
    "devDependencies": {
        "@ladybugdb/wasm-core": "0.21.2",
        "@types/node": "24.12.4",
        "typescript": "5.9.2",
        "vitest": "4.1.11"
    },
    "exports": {
        ".": {
            "browser": "./build/browser.js",
            "default": "./build/index.js"
        },
        "./browser": "./build/browser.js",
        "./package.json": "./package.json"
    },
    "peerDependencies": {
        "@ladybugdb/wasm-core": "0.21.2"
    },
    "peerDependenciesMeta": {
        "@ladybugdb/wasm-core": {
            "optional": true
        }
    }
}
