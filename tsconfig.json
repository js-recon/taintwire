{
    "compilerOptions": {
        "outDir": "./build",
        "target": "es2022",
        "module": "node16",
        "moduleResolution": "node16",
        "strict": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["./src/**/*"],
    "exclude": ["./src/**/*.test.ts", "./src/test-utils.ts"]
}
